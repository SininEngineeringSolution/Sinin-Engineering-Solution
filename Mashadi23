                <div class="space-y-3 pt-3 border-t border-slate-100">
                    <h4 class="text-xs font-extrabold text-brand-navy uppercase tracking-wider">TIN Certificate Details</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-600">TIN Number</label>
                            <input type="text" id="input-tin-no" class="w-full text-xs p-2.5 border rounded-lg focus:border-brand-orange">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600">TIN Reg Date</label>
                            <input type="text" id="input-tin-date" class="w-full text-xs p-2.5 border rounded-lg focus:border-brand-orange">
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-bold text-slate-600">Taxes Circle & Zone</label>
                            <input type="text" id="input-tin-circle" class="w-full text-xs p-2.5 border rounded-lg focus:border-brand-orange">
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" onclick="toggleEditModal()" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit" class="px-6 py-2 bg-brand-orange hover:bg-brand-orangeHover text-white text-xs font-bold rounded-lg shadow">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Logic & Dynamic Local Storage System -->
    <script>
        // Initial Default Data Object Extracted Directly From Government PDF Credentials
        const defaultDocData = {
            ownerName: "MD. RUHUL AMIN",
            phone: "01815592256",
            address: "9/A, Toynbee Circular Road, Motijheel, Comm. Area, Motijheel PS, Dhaka-1000, Bangladesh",
            tradeNo: "TRAD/DSCC/000033/2024",
            tradeNid: "3701711263",
            tradeIssue: "07/07/2026",
            tradeValidity: "Valid till June 30, 2027",
            binNo: "006287637-0202",
            binIssue: "08/08/2024",
            tinNo: "846173743066",
            tinDate: "October 25, 2016",
            tinCircle: "Taxes Circle-013 (Salary), Taxes Zone Narayanganj"
        };

        let currentDocData = { ...defaultDocData };

        // Load persisted state if available
        function loadStoredDocData() {
            try {
                const saved = localStorage.getItem('sinin_doc_data');
                if (saved) {
                    currentDocData = JSON.parse(saved);
                }
            } catch (e) {
                console.error("Local Storage not accessible", e);
            }
            renderDocData();
        }

        // Render current data to DOM elements
        function renderDocData() {
            // Owner & Address
            setText('display-owner-name', currentDocData.ownerName);
            setText('doc-trade-owner', currentDocData.ownerName);
            setText('doc-tin-taxpayer', currentDocData.ownerName);
            setText('display-office-address', currentDocData.address);
            setText('doc-bin-address', currentDocData.address);
            setText('contact-address-display', currentDocData.address);

            // Phone
            setText('doc-trade-phone', currentDocData.phone);
            setText('contact-phone-display', currentDocData.phone);

            // Trade License
            setText('doc-trade-no', currentDocData.tradeNo);
            setText('hero-lic-display', currentDocData.tradeNo);
            setText('footer-lic', currentDocData.tradeNo);
            setText('doc-trade-nid', currentDocData.tradeNid);
            setText('doc-trade-issue', currentDocData.tradeIssue);
            setText('doc-trade-validity', currentDocData.tradeValidity);

            // BIN
            setText('doc-bin-no', currentDocData.binNo);
            setText('hero-bin-display', currentDocData.binNo);
            setText('footer-bin', currentDocData.binNo);
            setText('doc-bin-issue', currentDocData.binIssue);

            // TIN
            setText('doc-tin-no', currentDocData.tinNo);
            setText('doc-bin-etin', currentDocData.tinNo);
            setText('hero-tin-display', currentDocData.tinNo);
            setText('doc-tin-date', currentDocData.tinDate);
            setText('doc-tin-circle', currentDocData.tinCircle);
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) el.innerText = value;
        }

        // Tab Switcher
        function switchDocTab(tabKey) {
            const tabs = ['trade', 'bin', 'tin'];
            tabs.forEach(t => {
                const contentEl = document.getElementById(`tab-content-${t}`);
                const btnEl = document.getElementById(`tab-btn-${t}`);
                
                if (t === tabKey) {
                    contentEl.classList.remove('hidden');
                    contentEl.classList.add('block');
                    btnEl.classList.add('border-brand-orange', 'text-brand-orange');
                    btnEl.classList.remove('border-transparent', 'text-slate-500');
                } else {
                    contentEl.classList.remove('block');
                    contentEl.classList.add('hidden');
                    btnEl.classList.remove('border-brand-orange', 'text-brand-orange');
                    btnEl.classList.add('border-transparent', 'text-slate-500');
                }
            });
        }

        // Edit Modal Controls
        function toggleEditModal() {
            const modal = document.getElementById('edit-modal');
            if (modal.classList.contains('hidden')) {
                // Populate inputs with current data
                document.getElementById('input-owner-name').value = currentDocData.ownerName;
                document.getElementById('input-phone').value = currentDocData.phone;
                document.getElementById('input-address').value = currentDocData.address;
                document.getElementById('input-trade-no').value = currentDocData.tradeNo;
                document.getElementById('input-trade-nid').value = currentDocData.tradeNid;
                document.getElementById('input-trade-issue').value = currentDocData.tradeIssue;
                document.getElementById('input-trade-validity').value = currentDocData.tradeValidity;
                document.getElementById('input-bin-no').value = currentDocData.binNo;
                document.getElementById('input-bin-issue').value = currentDocData.binIssue;
                document.getElementById('input-tin-no').value = currentDocData.tinNo;
                document.getElementById('input-tin-date').value = currentDocData.tinDate;
                document.getElementById('input-tin-circle').value = currentDocData.tinCircle;
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
        }

        function saveDocData(e) {
            e.preventDefault();
            currentDocData = {
                ownerName: document.getElementById('input-owner-name').value,
                phone: document.getElementById('input-phone').value,
                address: document.getElementById('input-address').value,
                tradeNo: document.getElementById('input-trade-no').value,
                tradeNid: document.getElementById('input-trade-nid').value,
                tradeIssue: document.getElementById('input-trade-issue').value,
                tradeValidity: document.getElementById('input-trade-validity').value,
                binNo: document.getElementById('input-bin-no').value,
                binIssue: document.getElementById('input-bin-issue').value,
                tinNo: document.getElementById('input-tin-no').value,
                tinDate: document.getElementById('input-tin-date').value,
                tinCircle: document.getElementById('input-tin-circle').value
            };

            try {
                localStorage.setItem('sinin_doc_data', JSON.stringify(currentDocData));
            } catch (err) {
                console.error("Failed saving to LocalStorage", err);
            }

            renderDocData();
            toggleEditModal();
        }

        function resetDocData() {
            currentDocData = { ...defaultDocData };
            try {
                localStorage.removeItem('sinin_doc_data');
            } catch (e) {}
            renderDocData();
        }

        // Mobile Nav Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Form Submit Handler
        function handleContactSubmit(e) {
            e.preventDefault();
            const msg = document.getElementById('form-success-msg');
            msg.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => {
                msg.classList.add('hidden');
            }, 6000);
        }

        // Initialize on load
        window.onload = function() {
            loadStoredDocData();
        };
    </script>
</body>
</html>
